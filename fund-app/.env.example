# FundFlow Flutter → fund-server
# Copy to .env for local work. Do not put JWT secrets here — those belong on the server.

# development | production
APP_ENV=development

# Must include the NestJS prefix /api/v1
# Windows / Chrome / iOS simulator:
API_BASE_URL=http://localhost:3001/api/v1

# Android emulator cannot use localhost (that is the emulator itself).
# 10.0.2.2 is the host machine from the emulator.
API_BASE_URL_ANDROID=http://10.0.2.2:3001/api/v1

# Physical Android/iOS device on the same Wi-Fi (replace with your PC IPv4):
# API_BASE_URL=http://192.168.1.10:3001/api/v1
# API_BASE_URL_ANDROID=http://192.168.1.10:3001/api/v1

WS_URL=http://localhost:3001
LOCALE=en
ACCEPT_LANGUAGE=en-US,en;q=0.9
